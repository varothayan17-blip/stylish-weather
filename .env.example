# ── Weather provider ────────────────────────────────────────────────────────
# Defaults to Open-Meteo (free, no key required). Only set these to switch.
# VITE_WEATHER_PROVIDER=open-meteo
# VITE_WEATHER_PROVIDER=weatherapi   (requires VITE_WEATHER_API_KEY)
# VITE_WEATHER_API_KEY=

# ── Firebase (Firestore) ─────────────────────────────────────────────────────
# All four vars are required to activate Firestore sync.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ── Notifications ────────────────────────────────────────────────────────────
# VITE_FIREBASE_VAPID_KEY=
# VITE_NOTIFICATIONS_ENABLED=true

# ── Stripe ────────────────────────────────────────────────────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Wardrobe AI (Anthropic) ──────────────────────────────────────────────────
# Server-only. NEVER use VITE_ prefix for any of these variables.
#
# WARDROBE_AI_SCANNING_ENABLED: Master on/off switch for AI wardrobe scanning.
#   Set to "true" in production only when:
#   - ANTHROPIC_API_KEY is configured;
#   - legal review of the scanner acknowledgement flow is complete;
#   - Privacy Policy and Terms of Service have been updated and published.
#   Defaults to disabled (fail-closed). Public scanning remains off.
# WARDROBE_AI_SCANNING_ENABLED=false
#
# ANTHROPIC_API_KEY: Anthropic API key for Claude access.
#   Server-only. Never commit. Already stored in Vercel for Production/Preview.
# ANTHROPIC_API_KEY=
#
# Scan quota limits are policy-locked constants in src/lib/policyVersions.ts.
# They are NOT configurable via environment variables in production.

# ── Production origin ────────────────────────────────────────────────────────
# AERUVO_ORIGIN=https://aeruvo.app
