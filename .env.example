# ── Weather provider ────────────────────────────────────────────────────────
# Defaults to Open-Meteo (free, no key required). Only set these to switch.
# VITE_WEATHER_PROVIDER=open-meteo
# VITE_WEATHER_PROVIDER=weatherapi   (requires VITE_WEATHER_API_KEY)
# VITE_WEATHER_API_KEY=

# ── Firebase (Firestore) ─────────────────────────────────────────────────────
# All four vars are required to activate Firestore sync.
# Without them the app works fully — data stays in localStorage only.
#
# MVP NOTE: The app uses Firestore keyed by normalized email address (no Firebase
# Auth). This is intentional for closed beta. For public launch, enable Firebase
# Auth and update Firestore security rules to enforce ownership by email.
# See src/lib/cloudSync.ts for the security comment in the Firestore path.
#
# Firestore security rules for MVP (open — trusted users only):
#   rules_version = '2';
#   service cloud.firestore {
#     match /databases/{database}/documents {
#       match /users/{emailKey}/{document=**} {
#         allow read, write: if true;
#       }
#     }
#   }
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=   # from Firebase Console → Project Settings → Cloud Messaging
# VITE_FIREBASE_APP_ID=

# ── Notifications (Stage D+) ─────────────────────────────────────────────────
# Required for Firebase Cloud Messaging (Web Push) push notifications.
# VITE_FIREBASE_VAPID_KEY is the Web Push certificate PUBLIC key from:
#   Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# This is safe to commit — it is a public key, not a secret.
# Note: messagingSenderId is part of the standard Firebase config (VITE_FIREBASE_APP_ID
# etc.) and does NOT need a separate VITE_* var.
#
# VITE_FIREBASE_VAPID_KEY=
#
# Show notification opt-in UI (Stage C/D). Hidden in production until
# Stage E (Cloud Function scheduler) is deployed and tested.
# VITE_NOTIFICATIONS_ENABLED=true

# ── Stripe ────────────────────────────────────────────────────────────────────
# VITE_ prefix = safe to expose in client bundle (publishable key only).
# Non-VITE_ vars = server-only, NEVER in client code or VITE_ variables.
#
# Client-side (safe):
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Server-only (NEVER commit, NEVER use VITE_ prefix):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREMIUM_PRICE_ID=price_...
#
# Firebase Admin (server-only — stringified JSON of service account):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"wethra-1aa65",...}
