rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Wethra Firestore Security Rules — Production
// ═══════════════════════════════════════════════════════════════════════════
//
// AUTH MODEL: Firebase Authentication (Email + Password)
// Every user has a verified Firebase Auth uid.
// Firestore documents are keyed by uid, not email.
//
// DATA STRUCTURE:
//   users/{uid}                         — profile + prefs document
//   users/{uid}/favorites/{favoriteId}  — saved outfit documents
//
// PRINCIPLE: Each authenticated user can only read and write their own data.
// No user can access another user's documents.
// Unauthenticated requests are denied everywhere.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Validation helpers ─────────────────────────────────────────────────

    // isValidPrefs: TRANSITIONAL rules for P1 migration.
    //
    // Context: legacy users may have prefs.premium and prefs.trialEndsAt in
    // Firestore from the old demo trial. These fields persist indefinitely.
    //
    // Why they persist: cloudSync.syncPrefs uses
    //   setDoc(ref, { prefs: sanitizePrefs(prefs) }, { merge: true })
    // Firestore merge:true operates at the FIELD-PATH level. Nested paths
    // omitted from the write (prefs.premium, prefs.trialEndsAt) are left
    // UNTOUCHED in the existing document. sanitizePrefs does NOT remove them.
    // Only an explicit FieldValue.delete() or a full setDoc without merge
    // would remove them. Neither happens in the current write path.
    //
    // Therefore:
    //   - premium/trialEndsAt may remain in Firestore indefinitely
    //   - They are NEVER authoritative for Premium (entitlement lives in
    //     users/{uid}/entitlements/premium, written by backend only)
    //   - These transitional rules tolerate their presence but prevent
    //     clients from creating or changing them
    //
    // REQUIRED P2/P4 CLEANUP (does NOT happen automatically):
    //   Run a one-time Admin SDK migration:
    //     db.doc(`users/${uid}`).update({
    //       'prefs.premium':    FieldValue.delete(),
    //       'prefs.trialEndsAt': FieldValue.delete(),
    //     })
    //   for every user document that contains these fields.
    //   After cleanup, tighten hasOnly() to coreAllowed only and
    //   remove legacyPrefsFieldsUntouched entirely.

    function isValidPrefs(data) {
      let coreAllowed = [
        'coldSensitivity', 'commute', 'city', 'theme',
        'name', 'email', 'onboarded',
        'clothingProfile'
      ];
      let allAllowed = coreAllowed.concat(['premium', 'trialEndsAt']);
      return data.keys().hasOnly(allAllowed)
        && data.coldSensitivity is string
        && data.commute is string
        && data.theme is string
        && data.onboarded is bool;
    }

    // Immutability guard for legacy premium/trialEndsAt.
    // If the field was absent in the existing doc it must remain absent.
    // If present it must be unchanged. Clients cannot add or modify them.
    function legacyPrefsFieldsUntouched(incoming, existing) {
      let premiumOk =
        (!('premium' in existing) && !('premium' in incoming))
        || (('premium' in existing) && ('premium' in incoming)
            && incoming.premium == existing.premium);
      let trialOk =
        (!('trialEndsAt' in existing) && !('trialEndsAt' in incoming))
        || (('trialEndsAt' in existing) && ('trialEndsAt' in incoming)
            && incoming.trialEndsAt == existing.trialEndsAt);
      return premiumOk && trialOk;
    }

    // ── notificationPrefs rule helpers ─────────────────────────────────
    //
    // Client-owned fields (readable and writable by the authenticated user):
    //   enabled, timezone, reminderHour, reminderMinute, schedulingVersion
    //
    // Backend-owned fields (written exclusively by Admin SDK / Cloud Function,
    //   never writable by the client SDK — enforced by the rules below):
    //   nextCheckAt, lastProcessedVersion
    //
    // schedulingVersion is a client-incrementable counter. When the client
    // changes timezone, reminderHour, or reminderMinute it also increments
    // schedulingVersion. The Cloud Function detects a mismatch between
    // schedulingVersion and lastProcessedVersion and recalculates nextCheckAt
    // before the next send. This is safe: the client controls only the signal
    // "please recalculate", not the actual nextCheckAt value.

    // Validates the VALUE TYPES of the client-owned fields.
    // Used for both CREATE (full map) and UPDATE (resulting map) checks.
    function notifPrefsValuesValid(np) {
      return np.enabled is bool
        && np.timezone is string
        && np.timezone.size() > 0
        && np.reminderHour is int
        && np.reminderHour >= 0
        && np.reminderHour <= 23
        && np.reminderMinute is int
        && np.reminderMinute >= 0
        && np.reminderMinute <= 59
        && np.schedulingVersion is int
        && np.schedulingVersion >= 0;
    }

    // On CREATE: notificationPrefs must not contain any backend-owned field.
    // The document does not yet exist, so there is no previous value to compare.
    function notifPrefsValidOnCreate(np) {
      let clientOwned = ['enabled', 'timezone', 'reminderHour', 'reminderMinute', 'schedulingVersion'];
      return np.keys().hasOnly(clientOwned)
        && notifPrefsValuesValid(np);
    }

    // On UPDATE: backend-owned fields (nextCheckAt, lastProcessedVersion) may
    // already exist in the stored document. The client must not add, remove, or
    // change them. We check this by asserting that for each backend field, if
    // it existed before, it is identical in the result, and if it did not exist
    // before, it is still absent in the result.
    //
    // request.resource.data = resulting document (after merge)
    // resource.data         = current document (before write)
    function notifPrefsBackendFieldsUntouched(incoming, existing) {
      // nextCheckAt: must be unchanged (present→same value, absent→still absent)
      let nextCheckAtOk =
        (!("nextCheckAt" in existing)
            && !("nextCheckAt" in incoming))
        || (("nextCheckAt" in existing)
            && ("nextCheckAt" in incoming)
            && incoming.nextCheckAt == existing.nextCheckAt);
      // lastProcessedVersion: same invariant
      let lastProcOk =
        (!("lastProcessedVersion" in existing)
            && !("lastProcessedVersion" in incoming))
        || (("lastProcessedVersion" in existing)
            && ("lastProcessedVersion" in incoming)
            && incoming.lastProcessedVersion == existing.lastProcessedVersion);
      return nextCheckAtOk && lastProcOk;
    }

    // On UPDATE: the resulting notificationPrefs map must contain only the
    // client-owned keys plus any backend-owned keys that already existed.
    function notifPrefsValidOnUpdate(incoming, existing) {
      let permitted = ['enabled', 'timezone', 'reminderHour', 'reminderMinute', 'schedulingVersion',
                       'nextCheckAt', 'lastProcessedVersion'];
      return incoming.keys().hasOnly(permitted)
        && notifPrefsValuesValid(incoming)
        && notifPrefsBackendFieldsUntouched(incoming, existing);
    }

    // isValidFavorite validates saved outfit documents.
    //
    // v2 documents include both:
    //   slots — structured FavSlot[] (authoritative, written by v2+ clients)
    //   items — string[] derived from slots (legacy compatibility)
    // v1 legacy documents include items only.
    //
    // Both shapes are accepted for backward compatibility.
    // Required fields: id, title, tempC, condition, savedAt (always present).
    // At least one of slots or items must be present.
    // String fields are capped to prevent abuse.
    function isValidFavorite(data) {
      // Firestore Rules CEL has no if/return — this is a single boolean expression.
      // All conditions are composed with && and ||.

      // Core required fields and their types/sizes
      let hasCore =
        data.keys().hasAll(['id', 'title', 'tempC', 'condition', 'savedAt'])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && data.title is string
        && data.title.size() <= 256
        && data.tempC is number
        && data.condition is string
        && data.condition.size() <= 128
        && data.savedAt is number;

      // Allowed top-level keys (no unexpected fields)
      let allowedKeys = ['id', 'title', 'slots', 'items', 'tempC', 'condition', 'savedAt'];
      let keysOk = data.keys().hasOnly(allowedKeys);

      // At least one of slots or items must be present as a list
      let hasSlots = ('slots' in data) && data.slots is list;
      let hasItems = ('items' in data) && data.items is list;
      let hasSlotOrItem = hasSlots || hasItems;

      // Size limits: slots ≤ 20, items ≤ 20
      let slotsOk = !hasSlots || data.slots.size() <= 20;
      let itemsOk = !hasItems || data.items.size() <= 20;

      return hasCore && keysOk && hasSlotOrItem && slotsOk && itemsOk;
    }

    // ── users/{uid} — profile document ────────────────────────────────────

    match /users/{uid} {

      // Only the authenticated owner may read their own profile.
      allow get: if request.auth != null && request.auth.uid == uid;

      // Only the authenticated owner may write their own profile.
      // Permitted top-level keys: prefs, notificationPrefs.
      // CREATE and UPDATE are handled separately because:
      //   • CREATE: no existing document exists, so we validate the full
      //             incoming map and ensure no backend fields are introduced.
      //   • UPDATE: the existing document may contain backend-owned fields
      //             (nextCheckAt, lastProcessedVersion). We allow the client
      //             to change client-owned fields while asserting that backend
      //             fields remain exactly as they were.
      allow create: if
        request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['prefs', 'notificationPrefs']) &&
        // prefs must be valid when present; new docs must not contain premium/trialEndsAt
        (!('prefs' in request.resource.data) || (
          isValidPrefs(request.resource.data.prefs) &&
          legacyPrefsFieldsUntouched(request.resource.data.prefs, {})
        )) &&
        // notificationPrefs: no backend fields allowed on create
        (!('notificationPrefs' in request.resource.data)
           || notifPrefsValidOnCreate(request.resource.data.notificationPrefs));

      allow update: if
        request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['prefs', 'notificationPrefs']) &&
        // prefs must be valid when present; and legacy fields must not be added/changed
        (!('prefs' in request.resource.data) || (
          isValidPrefs(request.resource.data.prefs) &&
          legacyPrefsFieldsUntouched(
            request.resource.data.prefs,
            'prefs' in resource.data ? resource.data.prefs : {}
          )
        )) &&
        // notificationPrefs: client-owned fields may change; backend fields must be unchanged
        (!('notificationPrefs' in request.resource.data)
           || notifPrefsValidOnUpdate(
                request.resource.data.notificationPrefs,
                // If notificationPrefs did not previously exist, treat as empty map
                'notificationPrefs' in resource.data
                  ? resource.data.notificationPrefs
                  : {}));

      // Deletes are intentionally disabled via the API.
      // Account deletion is handled by admin tooling on request.
      allow delete: if false;

      // ── users/{uid}/favorites — saved outfits ──────────────────────────

      match /favorites/{favoriteId} {

        // Only the authenticated owner may read their own favorites.
        allow read: if request.auth != null && request.auth.uid == uid;

        // Only the authenticated owner may write their own favorites.
        // The favorite must have all required fields and the document ID
        // must match the id field inside the document.
        allow create, update: if
          request.auth != null &&
          request.auth.uid == uid &&
          isValidFavorite(request.resource.data) &&
          request.resource.data.id == favoriteId;

        // Favorites cannot be deleted via the API.
        allow delete: if false;
      }

      // ── users/{uid}/devices/{deviceId} ──────────────────────────────
      // FID (Firebase Installation ID) + device metadata for push notifications.
      // Stage D uses register()/onRegistered() — the FID is stored as "fid".
      // One document per browser/device, keyed by a stable client-generated UUID.

      match /devices/{deviceId} {
        // Owner can read their own device records.
        allow read: if request.auth != null && request.auth.uid == uid;

        // CREATE: enable flow writes fid + createdAt for the first time.
        // fid must be a non-empty string, max 512 chars (FIDs are ~22 chars;
        // 512 gives headroom for future formats without accepting arbitrary data).
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
               "fid", "platform", "enabled", "createdAt", "updatedAt"
             ])
          && "fid" in request.resource.data
          && request.resource.data.fid is string
          && request.resource.data.fid.size() > 0
          && request.resource.data.fid.size() <= 512
          && "createdAt" in request.resource.data
          && request.resource.data.createdAt is int
          && request.resource.data.platform in ["web", "android", "ios"]
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is int;

        // UPDATE: disable flow updates enabled + updatedAt only.
        // createdAt must remain unchanged (compared to existing value).
        // fid may remain present (preserved from create) but is not required
        // in the incoming data because the disable flow uses merge:true
        // and does not re-send fid.
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
               "fid", "platform", "enabled", "createdAt", "updatedAt"
             ])
          && request.resource.data.platform in ["web", "android", "ios"]
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is int
          // createdAt must not change after creation
          && request.resource.data.createdAt == resource.data.createdAt;

        // Owner can delete their own device record (sign-out cleanup).
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ── users/{uid}/billing/{docId} ──────────────────────────────────
      // Backend-owned Stripe customer mapping.
      // Written exclusively by the server (Admin SDK) — never by the client.
      // Contains: stripeCustomerId, updatedAt
      // Client has no UI reason to read this; deny both directions.
      match /billing/{docId} {
        allow read:  if false;  // No client UI reads Stripe customer ID
        allow write: if false;  // Admin SDK only
      }

      // ── users/{uid}/checkout/{docId} ─────────────────────────────────
      // Server-controlled checkout session lease (state machine).
      // Written by Admin SDK only — never by the client.
      match /checkout/{docId} {
        allow read:  if false;  // Admin SDK only
        allow write: if false;  // Admin SDK only
      }

      // ── users/{uid}/consentRecords/{sessionId} ───────────────────────
      // Checkout consent records — retained for legal hold period.
      // Written by Admin SDK only. Client cannot read, write, or delete.
      match /consentRecords/{docId} {
        allow read:  if false;  // Admin SDK only
        allow write: if false;  // Admin SDK only
      }

      // ── users/{uid}/pendingDeletion/{docId} ───────────────────────────
      // Scheduled account deletion marker.
      // Written by Admin SDK only. Client cannot read, write, or delete.
      // The webhook reads this to complete scheduled deletions.
      match /pendingDeletion/{docId} {
        allow read:  if false;  // Admin SDK only
        allow write: if false;  // Admin SDK only
      }

      // ── users/{uid}/notificationEvents/{eventId} ─────────────────────
      // Deduplication + audit log for sent rain reminders.
      // Written exclusively by the Cloud Function via Admin SDK (which
      // bypasses Firestore Security Rules entirely).
      // Client reads are denied: Aeruvo has no notification-history UI.
      // If a history feature is added later, enable read with: allow read:
      //   if request.auth != null && request.auth.uid == uid;
      match /notificationEvents/{eventId} {
        allow read:  if false;  // No notification history UI yet
        allow write: if false;  // Admin SDK only (bypasses rules)
      }

      // ── users/{uid}/entitlements/{entitlementId} ──────────────────────
      // Premium entitlement documents.
      // Written EXCLUSIVELY by the backend via Admin SDK (Stripe webhook
      // handler). The client may read its own entitlement to determine
      // whether Premium features are available, but may NEVER write to it.
      //
      // Current document: users/{uid}/entitlements/premium
      // Fields: active, plan, source, status, trialEnd, currentPeriodEnd,
      //         cancelAtPeriodEnd, stripeCustomerId, stripeSubscriptionId,
      //         updatedAt
      //
      // P2/P3: After Stripe integration, the webhook handler writes this
      // document. Until then, no document exists → all users are Free.
      match /entitlements/{entitlementId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;  // Admin SDK only — client can NEVER grant itself Premium
      }

      // ── users/{uid}/quotas/{quotaId} ──────────────────────────────────
      // Server-side usage counters (e.g. wardrobeAi scan quota).
      // Written exclusively by Admin SDK via Firestore transactions.
      // Client must not write quotas — doing so would allow quota bypass.
      // Client read is denied; remaining scans are returned in the API response.
      match /quotas/{quotaId} {
        allow read:  if false;  // Remaining scans returned in API response body
        allow write: if false;  // Admin SDK only
      }
    }

    // ── deletionJobs/{jobId} ─────────────────────────────────────────────
    // Admin-only deletion job records. Live at the Firestore root (not
    // under users/{uid}) so they survive deletion of the user document tree
    // and are accessible via Admin SDK even after Firebase Auth is deleted.
    // Contains: job state, uid, timestamps, failed-collection list.
    // No client read or write is permitted.
    match /deletionJobs/{jobId} {
      allow read:  if false;  // Admin SDK only
      allow write: if false;  // Admin SDK only
    }

    // ── Deny everything else ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }

}
